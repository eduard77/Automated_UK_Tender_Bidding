# Contract: this file documents every environment variable read by the backend.
# If you add a new setting to `tender_agent/config.Settings`, add a matching
# entry here with a sensible default and a one-line comment explaining what it's
# for. The CI's `Backend (Python)` job and `docs/push-setup.md` assume the names
# stay in sync.
#
# Never commit a real `.env`. This file is the template; copy to `.env` and
# fill in real values for local dev.

# Database
DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5432/tender_agent

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Polling
POLL_INTERVAL_MINUTES=30
LOOKBACK_DAYS_INITIAL=7

# Source endpoints (override defaults if the upstream paths drift)
FTS_API_BASE=https://www.find-tender.service.gov.uk/api/1.0
CONTRACTS_FINDER_API_BASE=https://www.contractsfinder.service.gov.uk/Published/Notices/OCDS
PCS_API_BASE=https://api.publiccontractsscotland.gov.uk/v1
SELL2WALES_API_BASE=https://api.sell2wales.gov.wales/v1
ETENDERSNI_FEED_URL=https://etendersni.gov.uk/epps/cft/listContractNotices.do?type=atom

# Document storage. ONE writable, host-mounted location under /app/data — see
# the volume mount in docker-compose.yml (host: ~/.tender-agent/documents). All
# document/staging paths derive from this; never use a bare relative 'data' path.
DOCUMENT_STORAGE_DIR=/app/data/documents
DOCUMENT_MAX_BYTES=52428800

# HTTP behaviour
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=tender-agent/0.1 (compliance-research)

# Anthropic. ANTHROPIC_API_KEY is shared by every Claude caller in the
# backend (requirements extractor, portal classifier, bid-brief engine).
# Without it, /tenders/{id}/generate-brief records a failed brief with a
# clear "ANTHROPIC_API_KEY not set" message instead of erroring at 500.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Bid-brief engine (Phase 4 chunk 5). Override the model used by
# /tenders/{id}/generate-brief — defaults to claude-sonnet-4-6 (the named
# constant in services/brief/llm_client.py).
BRIEF_LLM_MODEL=claude-sonnet-4-6
# Approximate input-token budget when assembling the brief prompt. Lower
# this to trim cost on big ITT packs; the generator prioritises
# ITT/instructions, quality questionnaire, and specification docs.
BRIEF_MAX_INPUT_TOKENS=150000

# Web Push (VAPID). Generate a keypair with:
#   cd tender-agent-dashboard && npm run generate-vapid
# Put the PUBLIC key here (and only here) — the dashboard fetches it via
# GET /push/vapid-public-key. The private key never leaves the backend.
# See docs/push-setup.md for the full workflow.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Used in push notification payloads as the base URL for "open tender" links.
DASHBOARD_BASE_URL=http://localhost:3000

# Browser bridge (native Windows helper that runs OUTSIDE Docker — see
# browser-bridge/README.md). The container reaches the Windows host at
# host.docker.internal (docker-compose passes TENDER_AGENT_BRIDGE_URL through and
# adds extra_hosts so it also works on Linux engines).
#
# TENDER_AGENT_BRIDGE_TOKEN MUST be set to the SAME value as in
# browser-bridge/.env — it secures access to your logged-in browser, and the
# backend can't drive the bridge without it. (The legacy names BRIDGE_URL /
# BRIDGE_TOKEN are still accepted as a fallback.)
TENDER_AGENT_BRIDGE_URL=http://host.docker.internal:8765
TENDER_AGENT_BRIDGE_TOKEN=
# In-container mount of the host download folder the bridge writes to. The
# matching host path is wired in docker-compose.yml (see the volume note there).
BRIDGE_DOWNLOAD_DIR=/app/data/bridge-downloads
