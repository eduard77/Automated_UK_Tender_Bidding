# Contract: this file documents every environment variable read by the backend.
# If you add a new setting to `tender_agent/config.Settings`, add a matching
# entry here with a sensible default and a one-line comment explaining what it's
# for. The CI's `Backend (Python)` job and `docs/push-setup.md` assume the names
# stay in sync.
#
# Never commit a real `.env`. This file is the template; copy to `.env` and
# fill in real values for local dev.

# Database
DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5432/tender_agent

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# CORS — comma-separated list of dashboard origins allowed to call the API.
# Defaults (set in tender_agent/config.py) cover local dev so you don't need
# to set this for `npm run dev` against `uvicorn`. Set it explicitly in any
# non-dev deployment to your real dashboard origin(s). NEVER use "*" — the
# dashboard sends the session cookie with `credentials: "include"` and
# browsers reject wildcard origins on credentialed requests.
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Regex companion for the dashboard's RANDOM-SUFFIXED azurewebsites.net
# default hostname (can't be known before the app exists). The default in
# config.py already matches genera-tenders-dashboard*.azurewebsites.net,
# so the deployed dashboard works with NO extra setting. Origins matched
# by the regex are echoed back specifically (never "*"), so credentials
# stay safe. Set empty to disable.
# CORS_ALLOW_ORIGIN_REGEX=^https://genera-tenders-dashboard[a-z0-9-]*(?:\.[a-z0-9-]+)?\.azurewebsites\.net$

# Polling
POLL_INTERVAL_MINUTES=30
LOOKBACK_DAYS_INITIAL=7

# Source endpoints (override defaults if the upstream paths drift)
FTS_API_BASE=https://www.find-tender.service.gov.uk/api/1.0
CONTRACTS_FINDER_API_BASE=https://www.contractsfinder.service.gov.uk/Published/Notices/OCDS
PCS_API_BASE=https://api.publiccontractsscotland.gov.uk/v1
SELL2WALES_API_BASE=https://api.sell2wales.gov.wales/v1
ETENDERSNI_FEED_URL=https://etendersni.gov.uk/epps/cft/listContractNotices.do?type=atom

# EU-Supply / Mercell CTM public-tender listing. One adapter sweeps every
# configured tenant host's /ctm/Supplier/PublicTenders page (no login).
# EU_SUPPLY_API_BASE is the primary host (used for the Source row);
# EU_SUPPLY_PORTALS is the JSON list of hosts the adapter sweeps. The default
# now includes the Blue Light (police/emergency services) tenant alongside
# YORtender. The survey also mentioned uk.eu-supply.com — NOT added by
# default in case it aliases the same tenants (dedup would catch it, but
# why fetch twice); add it here if its listing proves distinct.
EU_SUPPLY_API_BASE=https://yortender.eu-supply.com
# EU_SUPPLY_PORTALS=["https://yortender.eu-supply.com","https://bluelight.eu-supply.com"]

# Atamis-on-Salesforce public Visualforce listing (no login). One adapter
# sweeps every configured tenant host's /?searchtype=Projects page. Defaults
# cover the NHS Health Family tenant (~4,900 opportunities) and UK Parliament;
# add future tenants to ATAMIS_PORTALS as JSON. ATAMIS_MAX_PAGES caps the
# newest-first page walk per tenant per poll cycle (10 rows/page).
ATAMIS_API_BASE=https://atamis-1928.my.salesforce-sites.com
# ATAMIS_PORTALS=["https://atamis-1928.my.salesforce-sites.com","https://atamis-ukparliament.my.salesforce-sites.com"]
ATAMIS_MAX_PAGES=5

# Proactis (ProContract) discovery — portal scope. The Find Opportunities
# panel scopes portals via a SINGLE-value dropdown ("All" default), so
# discovery loops one search per configured portal name. Matching against
# the dropdown's option labels is case-insensitive (exact, then prefix, then
# contains); names that match no option land in portals_not_found (loud,
# never a silent zero-row run). Leave UNSET to search "All" (the proven
# default). Labels CONFIRMED from the 2026-06-10 live capture: "London
# Tenders", "South East Business Portal", "EastMidsTenders" (one word).
# The rest are tolerant-match candidates — the filter-diagnostic endpoint
# returns the dropdown's full real option list (portal_options) to true
# them up:
# PROACTIS_DISCOVERY_PORTALS=["YPO","ESPO","The Chest","London Tenders","Supplying the South West","South East Business Portal","EastMidsTenders","Supply Staffordshire & Stoke-on-Trent"]

# Document storage. ONE writable, host-mounted location under /app/data — see
# the volume mount in docker-compose.yml (host: ~/.tender-agent/documents). All
# document/staging paths derive from this; never use a bare relative 'data' path.
DOCUMENT_STORAGE_DIR=/app/data/documents
DOCUMENT_MAX_BYTES=52428800

# Apply pending Alembic migrations at app startup (needed for the
# browser-only cloud deploy — there is no terminal step to run them).
# No-op when already at head. Set false to opt out.
MIGRATE_ON_STARTUP=true

# HTTP behaviour
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=tender-agent/0.1 (compliance-research)

# Credentials store master key (cloud-safe). Encrypts portal logins + email
# OAuth tokens at rest in the main Postgres DB (Fernet). ONE secret, set ONCE.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# On Azure: add as an App Service application setting with this exact name
# (Azure portal -> the App Service -> Settings -> Environment variables -> Add)
# and restart the app — browser only, no CLI. Locally you may leave it unset
# to fall back to the OS keyring (dev machines only). SECRET — never commit a
# real value here.
CREDENTIALS_ENCRYPTION_KEY=

# Anthropic (used for requirements extraction AND the bid-brief engine).
# The brief engine reads this key; missing key → brief generation fails with a
# clear "ANTHROPIC_API_KEY not set" error.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Discovery resilience (2026-06-12 outage hardening). A single source's poll
# is cancelled (and its run marked errored) after this many minutes so a hung
# source can never wedge the whole cycle; large response bodies get a more
# generous per-read timeout.
POLL_SOURCE_TIMEOUT_MINUTES=15
HTTP_READ_TIMEOUT_SECONDS=90

# Sector classification — the normalisation spine (Phase 3a). Every tender is
# AI-classified into a fixed sector taxonomy from its title + description, so
# the dashboard can filter by sector even when CPV is absent. Uses Haiku 4.5
# (cheapest model — ideal for classification; do NOT switch to Opus/Sonnet).
# Runs alongside the enrichment worker; the one-time backlog goes through the
# Batch API via POST /admin/classify/backfill. All have sensible defaults.
CLASSIFIER_ENABLED=true
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
CLASSIFIER_WORKER_BATCH_SIZE=20
CLASSIFIER_BACKFILL_BATCH_SIZE=500
# Max tenders per single Batch-API create inside a backfill run; larger limits
# are split into sequential chunks of this size (progress commits per chunk).
CLASSIFIER_BACKFILL_CHUNK_SIZE=500

# Bid-brief engine (chunk 5). Model override for the brief generator; default
# is claude-sonnet-4-6 (declared as a single named constant in services/brief).
# BRIEF_MAX_INPUT_TOKENS caps the document payload sent to the LLM (default
# ~150k); above the cap the engine truncates large spreadsheets and omits the
# lowest-priority docs.
BRIEF_LLM_MODEL=claude-sonnet-4-6
BRIEF_MAX_INPUT_TOKENS=150000

# Web Push (VAPID). Generate a keypair with:
#   cd tender-agent-dashboard && npm run generate-vapid
# Put the PUBLIC key here (and only here) — the dashboard fetches it via
# GET /push/vapid-public-key. The private key never leaves the backend.
# See docs/push-setup.md for the full workflow.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Used in push notification payloads as the base URL for "open tender" links.
DASHBOARD_BASE_URL=http://localhost:3000

# Operator account id for SYSTEM/operational push alerts (e.g. the portal
# orchestrator's "log in to fetch documents"). These aren't tied to an end user,
# so they go to this account's devices only. Leave unset → such alerts notify
# nobody (logged), never a cross-account broadcast. Also the natural target if
# you backfill legacy NULL-owner push subscriptions to a single operator.
# PUSH_OPERATOR_ACCOUNT_ID=1

# Browser bridge (native Windows helper that runs OUTSIDE Docker — see
# browser-bridge/README.md). The container reaches the Windows host at
# host.docker.internal (docker-compose passes TENDER_AGENT_BRIDGE_URL through and
# adds extra_hosts so it also works on Linux engines).
#
# TENDER_AGENT_BRIDGE_TOKEN MUST be set to the SAME value as in
# browser-bridge/.env — it secures access to your logged-in browser, and the
# backend can't drive the bridge without it. (The legacy names BRIDGE_URL /
# BRIDGE_TOKEN are still accepted as a fallback.)
TENDER_AGENT_BRIDGE_URL=http://host.docker.internal:8765
TENDER_AGENT_BRIDGE_TOKEN=
# In-container mount of the host download folder the bridge writes to. The
# matching host path is wired in docker-compose.yml (see the volume note there).
BRIDGE_DOWNLOAD_DIR=/app/data/bridge-downloads
# Per-slug Playwright persistent-context dir. The operator-uploaded Delta
# storage_state (login model B, cloud stage 3) is written to
# <BRIDGE_STATE_DIR>/delta_esourcing/storage_state.json and re-applied on launch.
# DEPLOY NOTE: in Azure this MUST be an Azure Files mount so the uploaded session
# survives a container restart — otherwise the operator must re-upload after
# every restart. Default below is the local/docker path.
BRIDGE_STATE_DIR=/app/data/bridge-sessions

# --- Email integration (Phase 6 §5.8) ---------------------------------------
# Connect an inbox over OAuth (read-only) and watch for tender emails by exact
# subject reference. The provider app registrations are a ONE-TIME operator
# setup done with your own provider access — see docs/email-setup.md for the
# exact, step-by-step checklists. Until the secrets below are set, the connect
# flow returns a clear "provider not configured yet" message.
EMAIL_POLL_ENABLED=false
EMAIL_POLL_INTERVAL_MINUTES=5
EMAIL_POLL_OVERLAP_MINUTES=10
EMAIL_INITIAL_LOOKBACK_DAYS=1
EMAIL_POLL_MAX_MESSAGES=50
# Must EXACTLY match the redirect URI registered with each provider, e.g.
# https://api.yourdomain/email/oauth/callback (or http://localhost:8000/email/oauth/callback in dev).
EMAIL_OAUTH_REDIRECT_URI=

# Google / Gmail (Gmail API, scope gmail.readonly). Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth client ID (Web application).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Microsoft / Outlook (Microsoft Graph, scopes Mail.Read offline_access User.Read).
# Azure Portal -> App registrations -> your app -> Certificates & secrets.
# MS_TENANT=common lets work/school + personal Microsoft accounts sign in.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# Yahoo (DEFERRED — see docs/email-setup.md). Yahoo needs OAuth2 + IMAP rather
# than a read-only mail API; the provider slot reports "not yet configured".
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Session cookie SameSite. EMPTY = auto: "none"+Secure when
# TENDER_AGENT_ENV=production (required so the browser sends the cookie from
# the cross-origin deployed dashboard), "lax" in local dev (the Next.js /__api
# rewrite keeps dev calls same-origin). Only set to force a specific value.
# SESSION_COOKIE_SAMESITE=
