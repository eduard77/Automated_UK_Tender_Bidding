# Copy to .env and set the SAME token as the backend's .env.
TENDER_AGENT_BRIDGE_TOKEN=change-me-to-a-long-random-string

# Optional overrides (defaults shown):
# TENDER_AGENT_BRIDGE_PORT=8765
# TENDER_AGENT_BRIDGE_STATE_DIR=%USERPROFILE%\.tender-agent\bridge-sessions
# TENDER_AGENT_BRIDGE_DOWNLOAD_DIR=%USERPROFILE%\.tender-agent\bridge-downloads
# TENDER_AGENT_BRIDGE_HEADLESS=1   # only the automated test sets this
