# Public URL of the tender-agent FastAPI backend.
# Local: http://localhost:8000  |  Docker compose: http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# VAPID public key for Web Push (subscribePush in lib/push.ts uses this).
# Generate a pair with: npm run generate-vapid
# Public key is safe to expose to the browser; the private key stays in the backend.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
