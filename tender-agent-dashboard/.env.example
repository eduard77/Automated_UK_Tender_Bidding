# Public URL of the tender-agent FastAPI backend.
# Local: http://localhost:8000  |  Docker compose: http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Web Push: the dashboard no longer reads the VAPID public key from env vars.
# It fetches it from the backend at /api/push/vapid-key (which proxies the
# backend's /push/vapid-public-key endpoint), so the key is configured in
# exactly one place: tender-agent/.env. See docs/push-setup.md.
