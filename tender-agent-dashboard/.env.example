# Contract: this file documents every environment variable read by the dashboard.
# If you add a new `process.env.XYZ` reference in dashboard source code, add a
# matching entry here. The CI's `Frontend (Next.js)` build step
# (.github/workflows/ci.yml) also reads from here, so name drift breaks the build.
#
# Never commit a real `.env*`. Copy this to `.env.local` and fill in real values.

# Public URL of the tender-agent FastAPI backend.
# Local: http://localhost:8000  |  Docker compose: http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Web Push: the dashboard does NOT read the VAPID public key from env vars.
# It fetches it from the backend at /api/push/vapid-key (which proxies
# /push/vapid-public-key). VAPID is configured in exactly one place:
# tender-agent/.env. See docs/push-setup.md.
